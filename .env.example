# ==============================================================================
# CẤU HÌNH HỆ THỐNG TRADING DASHBOARD & MULTI-AGENT COUNCIL
# ==============================================================================

# 1. CỔNG MÁY CHỦ (Default: 3000)
PORT=3000

# 2. KHÓA API MÔ HÌNH NGÔN NGỮ (LLM)
# Lựa chọn cổng AI ưu tiên: gemini | deepseek (Mặc định: gemini)
PRIMARY_LLM_PROVIDER=gemini

# Google Gemini API Key (Lấy tại: https://aistudio.google.com/)
GEMINI_API_KEY=

# --- GEMINI MODEL MATRIX (TỐI ƯU THEO VAI TRÒ AGENT) ---
# 👑 Model Tư duy sâu (Chủ tịch MasterCouncil & Sentinel Luật sư của Quỷ phản biện bẫy)
GEMINI_MODEL_PRO=gemini-2.5-pro

# 📊 Model Tiêu chuẩn / Cân bằng tốc độ (Agent Alpha Kỹ thuật SMC, AI Coach Kỷ luật, NLP Radar)
GEMINI_MODEL=gemini-2.5-flash

# ⚡ Model Siêu nhẹ (Nén bộ nhớ hội thoại & Tóm tắt nhanh)
GEMINI_MODEL_LITE=gemini-2.0-flash-lite

# [TÙY CHỌN / OPTIONAL] DeepSeek API (Dự phòng thông minh - không bắt buộc)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_REASONER=deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# [TÙY CHỌN / OPTIONAL] Ollama Local (Chạy offline không tốn phí - không bắt buộc)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_DEEP=deepseek-r1:8b
OLLAMA_MODEL=qwen2.5:7b

# 3. TIN TỨC & DỮ LIỆU THỊ TRƯỜNG (Tùy chọn - mặc định đã có dữ liệu mẫu và RSS)
CRYPTOCOMPARE_API_KEY=
